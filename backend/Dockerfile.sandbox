# Runtime image for untrusted Agent Python, JavaScript and shell commands.
FROM node:24-bookworm-slim AS node-runtime

FROM python:3.12-slim-bookworm

COPY --from=node-runtime /usr/local/ /usr/local/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    MPLCONFIGDIR=/tmp/matplotlib \
    HOME=/tmp

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash git tar \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir matplotlib numpy pandas pytest \
    && npm install --global tsx typescript \
    && npm cache clean --force \
    && mkdir -p /workspace /deps/node /deps/python \
    && chmod 0755 /workspace /deps /deps/node /deps/python

WORKDIR /tmp/workspace
CMD ["sh"]
