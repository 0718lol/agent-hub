{
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "prettier"
  ],
  "plugins": [
    "react",
    "react-hooks"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "no-empty-pattern": "off",
    "no-empty": "off",
    "no-case-declarations": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "*.min.js",
    "**/*.test.js",
    "**/*.test.jsx",
    "**/__mocks__/**",
    "**/ErrorBoundary.jsx"
  ]
}