# AgentHub Docker 环境变量配置
# 复制为 .env 后填写

# LLM 配置 (也可以启动后在设置面板中配置)
LLM_PROVIDER=openai          # openai | anthropic | ollama
LLM_API_KEY=sk-xxx           # API Key
LLM_BASE_URL=https://api.deepseek.com/v1   # API 地址
LLM_MODEL=deepseek-chat      # 模型名称

# Redis 配置
REDIS_PASSWORD=agenthub_redis_secret   # Redis 访问密码（修改后请同步修改 docker-compose.yml 中的默认值）
POSTGRES_PASSWORD=agenthub_postgres_secret

# Docker/生产安全配置（至少 32 字符）
AGENTHUB_API_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
AGENTHUB_ENCRYPT_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_STRING
# Bearer API clients should also send a stable X-AgentHub-Client-ID header.
AGENTHUB_AUTH_MODE=shared
AGENTHUB_TRUSTED_PROXY_SECRET=
AGENTHUB_TRUSTED_IDENTITY_HEADER=x-agenthub-auth-user
AGENTHUB_TRUSTED_ROLE_HEADER=x-agenthub-auth-role
AGENTHUB_API_CLIENT_TOKENS_JSON=
AGENTHUB_LOGIN_ATTEMPTS_PER_MINUTE=10

# 多主机部署可改为 s3，并填写 S3 或 MinIO 参数
AGENTHUB_STORAGE_BACKEND=local
AGENTHUB_S3_BUCKET=
AGENTHUB_S3_PREFIX=agenthub
AGENTHUB_S3_ENDPOINT_URL=
AGENTHUB_S3_REGION=us-east-1
AGENTHUB_S3_ACCESS_KEY_ID=
AGENTHUB_S3_SECRET_ACCESS_KEY=
AGENTHUB_CHROMA_HOST=
AGENTHUB_CHROMA_PORT=8000
AGENTHUB_CHROMA_SSL=false

# 可选：发布生成的静态 Web 项目到 Netlify
AGENTHUB_NETLIFY_TOKEN=                 # Netlify personal access token
AGENTHUB_NETLIFY_SITE_ID=               # Netlify site ID

# 可选：对外发布地址，例如 https://agenthub.example.com
AGENTHUB_PUBLIC_BASE_URL=

# 生成 API 容器资源上限
AGENTHUB_API_RUNTIME_MEMORY=512m
AGENTHUB_API_RUNTIME_CPUS=1.0
AGENTHUB_API_RUNTIME_PIDS=128
# Web/API build containers (host networking is rejected)
AGENTHUB_DEPLOYMENT_BUILD_NETWORK=default
AGENTHUB_DEPLOYMENT_BUILD_MEMORY=2g
AGENTHUB_DEPLOYMENT_BUILD_CPUS=2.0
AGENTHUB_DEPLOYMENT_BUILD_PIDS=256
AGENTHUB_RUNTIME_SANDBOX_IMAGE=agenthub-runtime-sandbox:local
AGENTHUB_RUNTIME_SANDBOX_MEMORY=768m
AGENTHUB_RUNTIME_SANDBOX_CPUS=1.5
AGENTHUB_RUNTIME_SANDBOX_PIDS=128
AGENTHUB_RUNTIME_SANDBOX_TIMEOUT=120
AGENTHUB_RUNTIME_SANDBOX_MAX_CONCURRENCY=4
AGENTHUB_RUNTIME_SANDBOX_MAX_PER_TENANT=1
AGENTHUB_PREVIEW_RUNTIME_MAX_TOTAL=8
AGENTHUB_PREVIEW_RUNTIME_MAX_PER_TENANT=2
AGENTHUB_RUNTIME_SANDBOX_QUEUE_TIMEOUT=30
AGENTHUB_RUNTIME_SANDBOX_DEPENDENCY_TIMEOUT=300
AGENTHUB_RUNTIME_SANDBOX_DEPENDENCY_CACHE_MAX=100
AGENTHUB_RUNTIME_DEPENDENCY_NETWORK=bridge
AGENTHUB_RUNTIME_NPM_REGISTRY=https://registry.npmjs.org
AGENTHUB_RUNTIME_PYPI_INDEX_URL=https://pypi.org/simple
AGENTHUB_E2B_TEMPLATE_ID=code-interpreter
AGENTHUB_DEPLOYMENT_RETENTION_DAYS=7
AGENTHUB_DEPLOYMENT_MAX_PER_USER=20
AGENTHUB_SCHEDULER_LEADER_TTL=20
AGENTHUB_GENERATION_WORKER_ENABLED=false
AGENTHUB_GENERATION_RECLAIM_IDLE_MS=120000
AGENTHUB_GENERATION_MAX_ATTEMPTS=1
AGENTHUB_GENERATION_LEASE_TTL=90
AGENTHUB_GENERATION_MAX_PER_USER=2
AGENTHUB_LLM_DAILY_TOKEN_QUOTA=0
# Only for the explicit docker-compose.local-docker.yml development override.
AGENTHUB_ALLOW_HOST_DOCKER_SOCKET=true

# 可选：人工审批通知
AGENTHUB_SLACK_WEBHOOK_URL=
AGENTHUB_TELEGRAM_BOT_TOKEN=
AGENTHUB_TELEGRAM_CHAT_ID=
